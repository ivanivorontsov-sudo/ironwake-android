; Engine configuration file.
; Godot 4.4 IRONWAKE Android client
config_version=5

[application]

config/name="IRONWAKE"
config/description="Device-authoritative tank combat client. Meta via Beget; combat local."
config/version="0.1.0"
run/main_scene="res://scenes/hangar.tscn"
config/features=PackedStringArray("4.4", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameState="*res://scripts/meta/game_state.gd"
ApiClient="*res://scripts/net/api_client.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

